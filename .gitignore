# —— LUTE Agentic System · monorepo 白名单式 .gitignore ——
# 策略：默认忽略全部 → 恢复目录 → 仅纳入经审批的目录与根级元文件
# （一次性补丁脚本/预览 HTML/构建产物/临时文件不入库）
# 维护规则：白名单条目必须指向磁盘上真实存在的路径；门禁 verify:* 会拒绝幽灵条目（ADR-0013）

*
!*/
!.gitignore
!/README.md
!/CHANGELOG.md
!/LICENSE
!AGENTS.md
!/package.json
!.github/**
!docs/**
!doc/**
!_doc-notes/**
!.scratch/**
!packaging/**
!81-Skills/**
!dsh-overseas-skills/**
!dsh-overseas-tools/**
!dsh-wanzh-hulian/**
!scripts/**
!dsh-skill-subset/**
!dsh-patches/**
!dsh-loopx-plugin/**
!dsh-memory-local/**
!dsh-auto-compact-local/**
!dsh-deepresearch-local/**
!dsh-agent-team-gui-local/**
!dsh-browser-local/**
!dsh-file-upload-local/**
!dsh-preset-lint-local/**
!dsh-rename-conversations/**
!dsh-renderer-heal/**
!dsh-reverse-skill-local/**
!dsh-root-brand-local/**
!dsh-skill-title-fix/**
!dsh-theme-local/**
!dsh-team-hub/**
!dsh-skill-center-local/**
!dsh-ui-polish-local/**
!explore-unknowns-local/**
!write-spec-local/**

# —— vendor 嵌套仓库：源码不入库，仅 pin 文件入库 ——
!vendor/
!vendor/dsh-desktop.pin
vendor/dsh-desktop/

# —— 纳入目录内的常见排除 ——
node_modules/
.doctor-backup/
staging/
dist/
generated/
*.tgz
.env
.env.*
credentials*
*.shn#
.DS_Store
*.log
!dsh-my-quotes/**

# —— 排除临时/备份文件（覆盖白名单，避免 git add -A 误纳入）——
*.bak-*
*.pre-*
*.orig*
dsh-overseas-skills/backup/
dsh-chatui-fix/
dsh-chatui-fix-backup/

# 2.0.0 构建源（app 直补副本 + rc 时代 profile 源；可重建，勿入库）
staging-src/
