#!/bin/bash
#
# 双击本文件：带 CDP 调试端口重启 DSH Desktop，并跑 C4 实况主题探针。
#
# ## 为什么必须双击，而不是在 DSH 里跑
#
# 本文件会**退出 DSH 自身**——因为要让 DSH 带上 `--remote-debugging-port`，只能在它
# 启动时把参数传进 argv，而一个已在运行的实例无法补上这个开关。
# 双击它，进程活在 Terminal 里，生命周期与 DSH 完全独立；在 DSH 内部执行则会被连带杀掉。
#
# ## 你会看到什么
#
#   1. DSH 自己关掉（含当前会话窗口）
#   2. DSH 自动重新打开
#   3. 本窗口打印探针的逐条结果
#
# ## 之后怎么回去
#
#   DSH 重新打开后，打开本会话告诉我一声，我读报告。
#   想测另一态（浅色↔深色）：在界面里切一次主题，再双击一次本文件（端口已开，会跳过重启）。
#
# ## 安全与副作用
#
#   - 调试端口只绑 127.0.0.1，不对网络暴露；用完正常 Cmd+Q 再启动一次 DSH 即可关掉它。
#   - 探针只读：不切主题、不写变量、不改可见状态；探针元素全程 visibility:hidden。
#   - 探针遍历样式表时可能有**秒级卡顿**，属预期。

cd "$(dirname "$0")" || {
  echo "进不了脚本目录：$(dirname "$0")"
  read -r _
  exit 1
}

bash ./relaunch-dsh-cdp.sh
code=$?

echo
echo "────────────────────────────────────────────────"
if [ "$code" = 0 ] || [ "$code" = 1 ]; then
  echo "探针跑完了（退出码 ${code}）。报告在 /tmp/theme-audit/c4/"
elif [ "$code" = 2 ]; then
  echo "没跑成（退出码 2）。把上面的输出整段复制回会话，我来定位。"
else
  echo "脚本异常退出（退出码 ${code}）。把上面的输出整段复制回会话。"
fi
echo "本窗口保持打开。看完按回车关闭。"
read -r _
exit "$code"
