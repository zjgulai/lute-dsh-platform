{
  "name": "dsh-rename-conversations",
  "version": "0.1.0",
  "luteOrigin": "self",
  "luteOwner": "lute",
  "lutePublish": false,
  "description": "会话标题规范化宿主插件：提供 rc_probe（只读盘点，含 Asia/Shanghai 日期换算与文本瘦身）、rc_batch_rename（一键批量重命名）、rc_rename（单条重命名）三个模型工具，走官方 sessionController 契约。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/globals.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "5.6.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
