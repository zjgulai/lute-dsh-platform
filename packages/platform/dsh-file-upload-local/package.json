{
  "name": "dsh-file-upload",
  "description": "在 composer 左下新增「上传文件」按钮：点击弹系统文件对话框，选中后复制进当前会话 workspace 的 uploads/ 目录并插入 @相对路径引用（模型经 read 工具读取）。",
  "version": "0.1.0-local.1",
  "luteOrigin": "self",
  "luteOwner": "lute",
  "lutePublish": false,
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
