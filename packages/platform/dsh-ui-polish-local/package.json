{
  "name": "dsh-ui-polish",
  "description": "LUTE 本机 UI 微调（DSH Desktop 2.0.5）：右栏 detailsCol 滚动条滑块透明、任务看板画布底部横向滚动条彻底移除（防中间框晃动）、会话正文/输入卡宽度 748→960px。纯 client CSS 注入，不改任何 app bundle 字节。",
  "version": "0.1.0-local.1",
  "luteOrigin": "self",
  "luteOwner": "lute",
  "lutePublish": false,
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/globals.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "happy-dom": "^20.11.1",
    "typescript": "5.6.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
