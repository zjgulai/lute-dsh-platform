{
  "name": "@yuxianglin/dsh-bridge-browser",
  "description": "Local alpha.1 port of dsh-bridge-browser: rc apiproxy surface replaced by the Typert Gateway compat layer.",
  "version": "0.0.3-alpha.1-port",
  "luteOrigin": "internalized",
  "luteOwner": "@yuxianglin",
  "lutePublish": false,
  "author": "Yuxiang Lin",
  "license": "MIT",
  "private": true,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "build": "tsc -b --pretty false && tsdown"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.61.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-agent-0.1.2-rc.1.tgz",
    "@deepseek-ai/dsh-api-gateway": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-api-gateway-0.1.2-rc.1.tgz",
    "@deepseek-ai/dsh-attachment": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-attachment-0.1.2-rc.1.tgz",
    "@deepseek-ai/dsh-home-paths": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-home-paths-0.1.2-rc.1.tgz",
    "@deepseek-ai/dsh-host-webserver": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-host-webserver-0.1.2-rc.1.tgz",
    "@deepseek-ai/dsh-invariants": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-invariants-0.1.2-rc.1.tgz",
    "@deepseek-ai/dsh-llm": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-llm-0.1.2-rc.1.tgz",
    "@deepseek-ai/dsh-session": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-session-0.1.2-rc.1.tgz",
    "@deepseek-ai/dsh-tools": "file:../../../vendor/dsh-desktop/vendor/dsh-runtime/0.1.2-rc.1/deepseek-ai-dsh-tools-0.1.2-rc.1.tgz"
