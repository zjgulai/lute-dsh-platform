        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "typescript": "5.6.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "node --test test/*.spec.mjs"
